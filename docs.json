{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Breakscale",
  "colors": {
    "primary": "#325cbd",
    "light": "#6f9bf0",
    "dark": "#23438c"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/faults-and-replay",
          "guides/break-it",
          "guides/verification",
          "guides/challenges",
          "guides/learning",
          "guides/incidents",
          "guides/traffic",
          "guides/shortcuts"
        ]
      },
      {
        "group": "For Developers",
        "pages": [
          "guides/developers"
        ]
      },
      {
        "group": "Examples",
        "pages": [
          "examples/single-server",
          "examples/load-balanced",
          "examples/cache-aside",
          "examples/async-workers",
          "examples/retry-storm",
          "examples/cdn-origin",
          "examples/rate-limited-api",
          "examples/circuit-breaker",
          "examples/read-replicas",
          "examples/sharded-database",
          "examples/autoscaling-service",
          "examples/multi-region",
          "examples/full-stack",
          "examples/specialised-stores",
          "examples/event-driven",
          "examples/resilient-delivery",
          "examples/checkout",
          "examples/discord",
          "examples/uber",
          "examples/netflix",
          "examples/spotify",
          "examples/twitter",
          "examples/stripe",
          "examples/whatsapp"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Simulator",
          "href": "https://breakscale.tech",
          "icon": "play"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/xevrion/breakscale",
          "icon": "github"
        },
        {
          "anchor": "Glossary",
          "href": "https://breakscale.tech/glossary",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/xevrion/breakscale"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open the simulator",
      "href": "https://breakscale.tech"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/xevrion/breakscale",
      "x": "https://x.com/xevrion_the1"
    }
  }
